# Required for the app to run at all
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required to send proposal emails (app/api/proposals/[id]/send)
RESEND_API_KEY=
PROPOSALS_FROM_EMAIL=          # must be on a domain verified in Resend, e.g. proposals@firestarterseo.com

# Used to build absolute client-facing proposal links in emails, e.g. https://proposals.firestarterseo.com
NEXT_PUBLIC_APP_URL=
